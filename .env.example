# ========================================================
# LEITOR MONOCROMÁTICO — VARIÁVEIS DE AMBIENTE (MONOREPO)
# ========================================================

# --- NEXT.JS FRONTEND ---
PORT=3000
API_URL=http://127.0.0.1:3001
API_PORT=3001
NEXT_PUBLIC_API_URL=

# --- EXPRESS BACKEND ---
DATA_DIR=data

# --- IA & LLM (NVIDIA NIM / OpenRouter) ---
# Adicione sua chave de API para habilitar geração em tempo real
NVIDIA_API_KEY=
AI_MODEL=z-ai/glm-5.3-flash
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# --- TTS & AUDIODESCRIÇÃO (HeyGen / OpenRouter) ---
HEYGEN_API_KEY=
HEYGEN_MODEL=heygen/heygen-voice-1-turbo:free
