# Porta do servidor da API
API_PORT=3001

# Diretório base das obras JSON
DATA_DIR=../../data

# Provedor LLM (NVIDIA NIM ou OpenRouter)
NVIDIA_API_KEY=
AI_MODEL=z-ai/glm-5.3-flash
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Provedor TTS / Audiodescrição por Voz
HEYGEN_API_KEY=
HEYGEN_MODEL=heygen/heygen-voice-1-turbo:free
