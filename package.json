{
  "name": "leitor-monocromatico",
  "version": "1.0.0",
  "private": true,
  "description": "Leitor Monocromático — Monorepo com Next.js Frontend e Backend API",
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"pnpm --filter @mono-reader/web dev\" \"pnpm --filter @mono-reader/api dev\"",
    "dev:web": "pnpm --filter @mono-reader/web dev",
    "dev:api": "pnpm --filter @mono-reader/api dev",
    "build": "pnpm --filter @mono-reader/shared build && pnpm --filter @mono-reader/api build && pnpm --filter @mono-reader/web build",
    "build:web": "pnpm --filter @mono-reader/web build",
    "build:api": "pnpm --filter @mono-reader/api build",
    "start": "concurrently -n \"web,api\" -c \"cyan,magenta\" \"pnpm --filter @mono-reader/web start\" \"pnpm --filter @mono-reader/api start\"",
    "start:web": "pnpm --filter @mono-reader/web start",
    "start:api": "pnpm --filter @mono-reader/api start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
